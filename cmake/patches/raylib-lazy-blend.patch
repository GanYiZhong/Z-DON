+// Set blending mode
+// Z-DON: lazy. The request is recorded and applied (batch flush + GL switch) by the next rlgl call that
+// draws or changes state (RLGL_RESOLVE_BLEND). Returning to the active mode before that cancels the
+// request, so End/BeginBlendMode pairs with nothing drawn in between no longer split the batch.
+// The batch is still flushed with the mode its vertices were added under, so the output is the same.
+void rlSetBlendMode(int mode)
+{
+#if defined(GRAPHICS_API_OPENGL_33) || defined(GRAPHICS_API_OPENGL_ES2)
+    if ((RLGL.State.currentBlendMode != mode) || ((mode == RL_BLEND_CUSTOM || mode == RL_BLEND_CUSTOM_SEPARATE) && RLGL.State.glCustomBlendModeModified))
+    {
+        rlBlendPending = true;
+        rlBlendPendingMode = mode;
+    }
+    else rlBlendPending = false;
+    if (!rlBlendLazy) RLGL_RESOLVE_BLEND();
+#endif
